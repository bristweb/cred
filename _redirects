# Cloudflare Pages only (GitHub Pages ignores this file). The repo is published as it is; these rules give the
# short public URLs. "200" = served from the real path without changing the address bar.
# Real paths (work on every static host, also GitHub Pages under /<repo>/):
#   /site/                     Cred's own pages
#   /template/                 dual-mode reviews page (also the iframe target)
#   /template/package/assets/  the widget        /template/data/   the bundled examples
/                 /site/                              200
# Old embed URLs → the dual-mode template page (301; query string preserved).
/embed.html       /template/                          301
/site/embed       /template/                          301
/site/embed.html  /template/                          301
/example          /example/                           301
/example/         /site/example                       200
/robots.txt       /site/robots.txt                    200
/sitemap.xml      /site/sitemap.xml                   200
/assets/*         /template/package/assets/:splat     200
/lang/*           /template/package/lang/:splat       200
/schemas/*        /template/package/schemas/:splat    200
/types/*          /template/package/types/:splat      200
/example/*        /template/data/:splat        200
/content/*        /data/:splat                        301
